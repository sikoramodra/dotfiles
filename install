#!/bin/bash

# https://raw.githubusercontent.com/sikoramodra/dotfiles/refs/heads/arch/install
# curl -LO https://raw.githubusercontent.com/sikoramodra/dotfiles/main/install.sh
# chmod +x install.sh
# ./install.sh

# Settings
DRIVE="/dev/nvme0n1" # Target disk, WILL BE WIPED when partitioning
PART_BOOT="/dev/nvme0n1p1"
PART_ROOT="/dev/nvme0n1p2"

LOCALTIME="Europe/Warsaw"
LOCALE1="en_US.UTF-8 UTF-8"
LOCALE2="pl_PL.UTF-8 UTF-8"
LANG="en_US.UTF-8"
KEYMAP="pl"
HOSTNAME="Arch"
USER="wm"

set -euo pipefail # Exit on error, undefined variables, and pipe failures

# Color codes for better output
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

error() {
  echo -e "${RED}[ERROR]${NC} $1" >&2
}

warning() {
  echo -e "${YELLOW}[WARNING]${NC} $1"
}

info() {
  echo -e "${BLUE}[INFO]${NC} $1"
}

check_uefi() {
  if [[ ! -d "/sys/firmware/efi/efivars" ]]; then
    error "This script requires UEFI boot mode. Legacy BIOS is not supported."
    exit 1
  fi
}

check_internet() {
  if ! ping -c 1 archlinux.org &>/dev/null; then
    error "No internet connection. Please connect to the internet first."
    return 1
  fi
  info "Internet connection confirmed"
}

confirm() {
  local prompt="$1"
  local response

  while true; do
    read -r -p "$prompt [Y/n] " response
    response=${response:-Y}
    case "$response" in
    [Yy] | [Yy]es) return 0 ;;
    [Nn] | [Nn]o) return 1 ;;
    *) echo "Please answer yes or no." ;;
    esac
  done
}

## Root check
if [ "$(id -u)" != 0 ]; then
  error "This script MUST be run as root user!"
  exit 1
fi

## Initial setup
check_uefi
loadkeys "$KEYMAP"
clear

## Network
while confirm "Do you want to configure WiFi with iwd?"; do
  info "Available network interfaces:"
  ip link show
  echo
  info "iwd commands:"
  echo "  device list"
  echo "  station <INTERFACE> scan"
  echo "  station <INTERFACE> get-networks"
  echo "  station <INTERFACE> connect <NETWORK_NAME>"
  echo "  exit"
  echo
  printf "Press any key to launch iwd..."
  read -n 1 -s -r

  iwctl
  clear

  if check_internet; then
    break
  else
    error "No internet connection. Please try again."
  fi
done

## System clock
info "Updating system clock..."
timedatectl set-ntp true && sleep 2
clear

# Partitioning
if confirm "Do you want to partition $DRIVE?"; then
  if [[ ! -b "$DRIVE" ]]; then
    error "Drive $DRIVE does not exist!"
    exit 1
  fi

  info "Current layout of $DRIVE:"
  lsblk "$DRIVE"
  echo
  info "New partition scheme:"
  echo "1. /boot - 2G              - Type: EFI System"
  echo "2. /     - Remaining space - Type: Linux filesystem"
  echo
  warning "This will ERASE EVERYTHING on $DRIVE!"
  if ! confirm "Wipe $DRIVE and create the partitions above?"; then
    error "Partitioning cancelled."
    exit 1
  fi

  # Release anything left over from a previous attempt
  umount -R /mnt 2>/dev/null || true
  cryptsetup close cryptroot 2>/dev/null || true
  clear

  info "Creating partitions..."
  sfdisk --wipe always --wipe-partitions always "$DRIVE" <<EOF
label: gpt
size=2G, type=U, name="ESP"
type=L, name="cryptroot"
EOF
  udevadm settle
  partprobe "$DRIVE" || true
  udevadm settle
  clear
fi

## Filesystem
if confirm "Do you want to format partitions and set up filesystems?"; then
  warning "This will format the following partitions:"
  echo "  Root: $PART_ROOT (btrfs)"
  echo "  Boot: $PART_BOOT (FAT32)"
  echo
  if ! confirm "Continue with formatting? This will destroy all data on these partitions!"; then
    error "Filesystem setup cancelled."
    exit 1
  fi

  # Release anything left over from a previous attempt
  umount -R /mnt 2>/dev/null || true
  cryptsetup close cryptroot 2>/dev/null || true
  clear

  info "Formatting boot partition..."
  wipefs --all --force "$PART_BOOT"
  mkfs.fat -F 32 -n ESP "$PART_BOOT"
  clear

  info "Setting up LUKS2 on $PART_ROOT (you will be asked for a passphrase)..."
  wipefs --all --force "$PART_ROOT"
  cryptsetup luksFormat --type luks2 --label cryptroot --verify-passphrase --batch-mode "$PART_ROOT"
  cryptsetup open "$PART_ROOT" cryptroot
  ROOT_DEV="/dev/mapper/cryptroot"
  clear

  info "Creating btrfs filesystem and subvolumes..."
  mkfs.btrfs -f -L Arch "$ROOT_DEV"
  mount "$ROOT_DEV" /mnt
  btrfs subvolume create /mnt/@
  btrfs subvolume create /mnt/@home
  btrfs subvolume create /mnt/@snapshots
  btrfs subvolume create /mnt/@log
  btrfs subvolume create /mnt/@cache
  umount /mnt

  mount -o subvol=@,compress=zstd,noatime "$ROOT_DEV" /mnt
  mkdir -p /mnt/{home,.snapshots,var/log,var/cache}

  mount -o subvol=@home,compress=zstd,noatime "$ROOT_DEV" /mnt/home
  mount -o subvol=@snapshots,compress=zstd,noatime "$ROOT_DEV" /mnt/.snapshots
  mount -o subvol=@log,compress=zstd,noatime "$ROOT_DEV" /mnt/var/log
  mount -o subvol=@cache,compress=zstd,noatime "$ROOT_DEV" /mnt/var/cache
  chmod 750 /mnt/.snapshots

  mkdir -p /mnt/boot
  mount -o umask=0077 "$PART_BOOT" /mnt/boot
  clear

  info "Resulting mounts:"
  findmnt --real --submounts --target /mnt -o TARGET,SOURCE,FSTYPE,OPTIONS
  echo
  printf "Press any key to continue..."
  read -n 1 -s -r
  clear
fi

## Pacstrap
while confirm "Do you want to run pacstrap?"; do
  info "Installing base packages..."
  pacman-key --init
  pacman-key --populate archlinux
  pacman -Sy --noconfirm archlinux-keyring
  pacstrap -K /mnt \
    base base-devel linux linux-firmware linux-headers \
    btrfs-progs lvm2 cryptsetup snapper snap-pac zram-generator \
    networkmanager neovim git openssh \
    man-db man-pages texinfo \
    dosfstools efibootmgr limine \
    amd-ucode mesa vulkan-radeon
  clear
done

## Fstab
if confirm "Do you want to generate fstab?"; then
  genfstab -U /mnt >>/mnt/etc/fstab
  clear
fi

## Chroot
if confirm "Do you want to chroot and configure the system?"; then
  # Timezone setup
  info "Setting up timezone..."
  arch-chroot /mnt ln -sf /usr/share/zoneinfo/"$LOCALTIME" /etc/localtime
  arch-chroot /mnt hwclock --systohc

  # Locale setup
  info "Configuring locales..."
  arch-chroot /mnt bash -c "echo '$LOCALE1' >> /etc/locale.gen"
  arch-chroot /mnt bash -c "echo '$LOCALE2' >> /etc/locale.gen"
  arch-chroot /mnt locale-gen
  arch-chroot /mnt bash -c "echo 'LANG=$LANG' > /etc/locale.conf"

  # Keymap setup
  info "Setting up keymap..."
  arch-chroot /mnt bash -c "echo 'KEYMAP=$KEYMAP' > /etc/vconsole.conf"

  # Hostname setup
  info "Configuring hostname..."
  arch-chroot /mnt bash -c "echo '$HOSTNAME' > /etc/hostname"
  arch-chroot /mnt bash -c "cat > /etc/hosts <<EOF
127.0.0.1    localhost
::1          localhost
127.0.1.1    ${HOSTNAME}.localdomain    ${HOSTNAME}
EOF"

  # User setup
  info "Setting root password"
  arch-chroot /mnt passwd root

  info "Creating user: $USER"
  arch-chroot /mnt useradd -m -G wheel,video -s /bin/bash "$USER"

  info "Setting password for user: $USER"
  arch-chroot /mnt passwd "$USER"

  # Sudo setup
  info "Configuring sudo access..."
  arch-chroot /mnt bash -c "echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel"
  arch-chroot /mnt chmod 440 /etc/sudoers.d/10-wheel
  # arch-chroot /mnt bash -c "echo '%wheel ALL=(ALL:ALL) ALL' >> /etc/sudoers"

  # Network setup
  info "Enabling network services..."
  arch-chroot /mnt systemctl enable NetworkManager

  # zram swap
  info "Configuring zram..."
  cat >/mnt/etc/systemd/zram-generator.conf <<EOF
[zram0]
zram-size = ram
compression-algorithm = zstd
swap-priority = 100
EOF

  # initramfs: LUKS (encrypt) before filesystems, keymap for the passphrase prompt.
  info "Configuring initramfs hooks..."
  mkdir -p /mnt/etc/mkinitcpio.conf.d
  cat >/mnt/etc/mkinitcpio.conf.d/10-luks-btrfs.conf <<'EOF'
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block encrypt filesystems)
EOF
  arch-chroot /mnt mkinitcpio -P

  # Bootloader setup
  info "Installing Limine bootloader..."
  mkdir -p /mnt/boot/EFI/limine /mnt/boot/EFI/BOOT
  cp /mnt/usr/share/limine/BOOTX64.EFI /mnt/boot/EFI/limine/BOOTX64.EFI
  cp /mnt/usr/share/limine/BOOTX64.EFI /mnt/boot/EFI/BOOT/BOOTX64.EFI

  # Keep the EFI binary current when the limine package is upgraded
  mkdir -p /mnt/etc/pacman.d/hooks
  cat >/mnt/etc/pacman.d/hooks/90-limine-deploy.hook <<'EOF'
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = limine

[Action]
Description = Deploying Limine EFI binary to the ESP...
When = PostTransaction
Exec = /usr/bin/sh -c '/usr/bin/install -Dm644 /usr/share/limine/BOOTX64.EFI /boot/EFI/limine/BOOTX64.EFI && /usr/bin/install -Dm644 /usr/share/limine/BOOTX64.EFI /boot/EFI/BOOT/BOOTX64.EFI'
EOF

  CRYPT_PART=$(cryptsetup status cryptroot | awk '/device:/ {print $2}')
  LUKS_UUID=$(blkid -s UUID -o value "$CRYPT_PART")
  CMDLINE="cryptdevice=UUID=${LUKS_UUID}:cryptroot:allow-discards root=/dev/mapper/cryptroot rootflags=subvol=@ rootfstype=btrfs rw"

  # Limine config
  cat >/mnt/boot/limine.conf <<EOF
timeout: 0

/Arch Linux
  protocol: linux
  path: boot():/vmlinuz-linux
  cmdline: ${CMDLINE}
  module_path: boot():/initramfs-linux.img

/Arch Linux (fallback initramfs)
  protocol: linux
  path: boot():/vmlinuz-linux
  cmdline: ${CMDLINE}
  module_path: boot():/initramfs-linux-fallback.img
EOF

  # UEFI boot entry
  efibootmgr --create --disk "$DRIVE" --part 1 \
    --label "Limine" --loader '\EFI\limine\BOOTX64.EFI'

  # LATER: yay -S limine-mkinitcpio-hook limine-snapper-sync #snap-pac,snapper
  # LATER: sudo limine-mkinitcpio
  # LATER: sudo systemctl enable --now limine-snapper-sync.service
  # LATER: TTY + uwsm + plymouth(LUKS password prompt + boot splash)

  clear
fi

## Post Install
umount -R /mnt
cryptsetup close cryptroot || true
clear

info "Installation completed successfully!"
info "The system will reboot in 10 seconds"
info "Press Ctrl+C to cancel reboot and stay in live environment"

for i in {10..1}; do
  echo -ne "\rRebooting in $i seconds..."
  sleep 1
done

reboot
