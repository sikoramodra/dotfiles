[
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "space": null, // Disable the default action vim::WrappingRight
    },
  },
  // Normal and visual mode
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      // Wrap line jk
      "j": ["workspace::SendKeystrokes", "g j"],
      "k": ["workspace::SendKeystrokes", "g k"],
    },
  },
  // Normal mode only
  {
    "context": "vim_mode == normal",
    "bindings": {
      // Yank to the end of line
      "Y": "vim::YankToEndOfLine"
    },
  },
  // Visual mode only
  {
    "context": "vim_mode == visual",
    "bindings": {
      // Select syntax nodes
      "V": "vim::SelectLargerSyntaxNode",
      "v": "vim::SelectSmallerSyntaxNode",
      // Don't deselect after indent level inc/dec
      ">": ["workspace::SendKeystrokes", "> g v"],
      "<": ["workspace::SendKeystrokes", "< g v"],
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      // Pane navigation
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      // Pane resizing
      "ctrl-left": "vim::ResizePaneLeft",
      "ctrl-right": "vim::ResizePaneRight",
      "ctrl-up": "vim::ResizePaneUp",
      "ctrl-down": "vim::ResizePaneDown",
      // Switch between buffers
			"shift-h": "pane::ActivatePreviousItem",
			"shift-l": "pane::ActivateNextItem",
      // Move lines
      "alt-k": "editor::MoveLineUp",
			"alt-j": "editor::MoveLineDown",
			// Searching
			"space space": "file_finder::Toggle",
      "shift shift": "project_symbols::Toggle",
      "ctrl ctrl": "outline::Toggle",
      "space /": "workspace::NewSearch",
      // Git operations
      "space g g": "git_panel::ToggleFocus",
      "space g f": "git::FileHistory",
      "space g d": "editor::ToggleSelectedDiffHunks",
      "space g D": "git::Diff",
      "space g s": "git::ToggleStaged",
      "space g x": "git::Restore",
      "space g b": "git::Blame",
      "space g c": "editor::OpenGitBlameCommit",
 			"] g": "editor::GoToHunk",
			"[ g": "editor::GoToPreviousHunk",
      // Files
      "space e": "project_panel::ToggleFocus",
      "space f f": "file_finder::Toggle",
      "space f p": "projects::OpenRecent",
      "space f b": "tab_switcher::ToggleAll",
      "space f t": "workspace::NewTerminal",
      "space f T": "workspace::OpenInTerminal",
      // Code actions
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "space c d": "editor::ToggleInlineDiagnostics",
      "space c l": "lsp_tool::ToggleMenu",
      // LSP
			"g d": "editor::GoToDefinition",
			"g D": "editor::GoToDeclaration",
			"g r": "editor::FindAllReferences",
			"g i": "editor::GoToImplementation",
			"g t": "editor::GoToTypeDefinition",
			"g K": "editor::ShowSignatureHelp",
			"] d": "editor::GoToDiagnostic",
			"[ d": "editor::GoToPreviousDiagnostic",
			// Go to file
      "g f": "editor::OpenExcerpts",
      // Debug
      "space d t": "debug_panel::ToggleFocus",
      "space d b": "editor::ToggleBreakpoint",
      // "space d B": "editor::EditConditionalBreakpoint",
      "space d l": "editor::EditLogBreakpoint",
      // Search selected term
      "space s s": "pane::DeploySearch",
      "space s r": ["pane::DeploySearch", { "replace_enabled": true }],
      // Clear all notifications
      "space s n d": "workspace::ClearAllNotifications",
      // Diagnostics
      "space s d": "diagnostics::Deploy",
      "space s D": "diagnostics::DeployCurrentFile",
      // TODO search
      "space s t": [
        "pane::DeploySearch",
        { "query": "TODO" }
      ],
      "space s T": [
        "pane::DeploySearch",
        { "query": "(TODO|FIX|FIXME)", "regex": true }
      ],
      // Buffers
 			"space b d": "pane::CloseActiveItem",
			"space b o": "pane::CloseOtherItems",
			// Toggles
			"space u w": "editor::ToggleSoftWrap",
			"space u p": "zed::OpenPerformanceProfiler",
      // Save without format
      "space w": "workspace::SaveWithoutFormat",
      // Markdown preview
			"space m p": "markdown::OpenPreview",
			"space m P": "markdown::OpenPreviewToTheSide",
      // Agent panel
      "space a t": "agent::Toggle",
      "space a f": "agent::ToggleFocus",
      "space a m": "agent::ToggleModelSelector",
      "space a p": "agent::ManageProfiles",
      "space a e": "agent::ToggleThinkingEffortMenu",
 			"space a n": "agent::NewThread",
      "space a d": "agent::OpenAgentDiff",
			"space a v": [
				"action::Sequence",
				["agent::ToggleFocus", "agent::AddSelectionToThread"],
			],
			// Open threads sidebar
      "space t t": "multi_workspace::ToggleWorkspaceSidebar",
      "space t f": "multi_workspace::FocusWorkspaceSidebar",
    },
  },
  // Threads sidebar
  {
    "context": "ThreadsSidebar || (ThreadsSidebar > Editor)",
    "bindings": {
      "escape escape": "multi_workspace::CloseWorkspaceSidebar",
      "tab": "agents_sidebar::ToggleThreadHistory",
      "/": "agents_sidebar::FocusSidebarFilter",
      "space t n": [
        "action::Sequence",
				[
				  "agents_sidebar::NewThreadInGroup",
					"multi_workspace::ToggleWorkspaceSidebar"
				],
      ],
      "space t x": "agent::ArchiveSelectedThread",
      // Pane navigation
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  // Multibuffer navigation
  {
    "context": "Editor && VimControl && vim_mode == normal && multibuffer",
    "bindings": {
      "escape escape": "pane::CloseMultibufferItems",
      "n": "editor::MoveToStartOfNextExcerpt",
      "N": "editor::MoveToEndOfPreviousExcerpt"
    }
  },
  // Buffer search
  {
    "context": "BufferSearchBar > Editor",
    "bindings": {
      "tab": "search::ToggleReplace",
    },
  },
  {
    "context": "BufferSearchBar && in_replace > Editor",
    "bindings": {
      "enter": "search::ReplaceNext",
      "ctrl-enter": "search::ReplaceAll",
    },
  },
  // Project search
  {
    "context": "ProjectSearchBar > Editor",
    "bindings": {
      "tab": "search::ToggleReplace",
    },
  },
  {
    "context": "ProjectSearchView > Editor",
    "bindings": {
      "/": "search::FocusSearch",
      "n": "search::SelectNextMatch",
      "N": "search::SelectPreviousMatch"
    },
  },
  {
    "context": "ProjectSearchBar && in_replace > Editor",
    "bindings": {
      "enter": "search::ReplaceNext",
      "ctrl-enter": "search::ReplaceAll",
    },
  },
  // Terminal panel action
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-t": "workspace::NewTerminal",
      "ctrl-w": "pane::CloseActiveItem",
    },
  },
  // Recent projects
  {
    "context": "RecentProjects",
    "bindings": {
      "ctrl-o": "workspace::Open",
      "ctrl-r": "projects::OpenRemote",
    },
  },
  // Left dock exit pane
  {
    "context": "(GitPanel || ProjectPanel) && !editing && !(vim_mode == insert)",
    "bindings": {
      "escape escape": "workspace::ToggleLeftDock",
    },
  },
  // Agent panel action
  {
    "context": "AgentPanel && !(vim_mode == insert)",
    "bindings": {
      "escape escape": "workspace::ToggleRightDock",
    },
  },
  // Pane splits
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space |": "pane::SplitVertical",
      "space -": "pane::SplitHorizontal",
    },
  },
  // Close dock and search panes
  {
    "context": "(Pane && !Editor) || ProjectSearchBar",
    "bindings": {
      "escape escape": "pane::CloseActiveItem",
    },
  },
  // Project panel
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "y": "workspace::CopyRelativePath",
      ":": "command_palette::Toggle",
      "/": "project_panel::NewSearchInDirectory",
      "enter": "project_panel::OpenPermanent",
      "j": "menu::SelectNext",
      "J": "project_panel::SelectNextDirectory",
      "k": "menu::SelectPrevious",
      "K": "project_panel::SelectPrevDirectory",
      "-": "project_panel::SelectParent",
 			// Close project panel
			"q": "workspace::ToggleLeftDock",
			"space e": "workspace::ToggleLeftDock",
			// Navigate between panel
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-l": "workspace::ActivatePaneRight",
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-j": "workspace::ActivatePaneDown",
    },
  },
 	// Toggle terminal
	{
		"context": "Terminal",
		"bindings": {
			"ctrl-h": "workspace::ActivatePaneLeft",
			// "ctrl-l": "workspace::ActivatePaneRight", FIXME: breaks zsh clear
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-j": "workspace::ActivatePaneDown",
		},
	},
  // Debug panel actions
  {
    "context": "DebugPanel && !Editor",
    "bindings": {
      "escape escape": "workspace::ToggleBottomDock",
      "c": "debugger::Continue",
      "r": "debugger::Rerun",
      "s": "debugger::StepOver",
      "x": "debugger::Stop",
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
    },
  },
  {
    "context": "DebugPanel",
    "bindings": {
      "alt-v": "debugger::FocusVariables",
      "alt-c": "debugger::FocusConsole",
    },
  },
]
