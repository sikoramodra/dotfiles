{
  // AI
  "edit_predictions": {
    "provider": "zed",
    "allow_data_collection": "no",
  },
  "agent_servers": {
    // "pi-acp": {
    //   "type": "registry"
    // },
    // "opencode": {
    //   "type": "registry"
    // }
  },
  "agent": {
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
      "effort": "high",
    },
  },


  // Appearance
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "ui_font_size": 15,
  "buffer_font_family": "Source Code Pro",
  "buffer_font_size": 15,
  "buffer_line_height": { "custom": 1.5 },


  // Editor
  "vim_mode": true,
  "format_on_save": "on",
  "wrap_guides": [80, 100],
  "vertical_scroll_margin": 4,
  "horizontal_scroll_margin": 8,
  "tab_size": 2,
  "cursor_blink": false,
  "scrollbar": {
    "cursors": false,
  },
  "auto_signature_help": false,
  "use_smartcase_search": true,
  "vim": {
    "use_smartcase_find": true,
  },


  // General
  "autosave": "on_focus_change",
  "autoscroll_on_clicks": true,
  "restore_on_startup": "launchpad",
  "cli_default_open_behavior": "new_window",
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "journal": {
    "hour_format": "hour24",
  },
  "session": {
    "trust_all_worktrees": true
  },


  // Workspace
  "title_bar": {
    "show_sign_in": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  // "status_bar": {
  //   "show_active_file": false,
  //   "experimental.show": false,
  // },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "activate_on_close": "left_neighbour",
  },
  "project_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "collapse_untracked_diff": true,
    "file_icons": true,
    "tree_view": true,
  },
  "outline_panel": {
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 0
  },


  // Languages
  "languages": {
    "Shell Script": {
      "language_servers": ["bash-language-server", "..."],
      "formatter": "language_server",
    },
    "Lua": {
      "language_servers": ["lua-language-server"],
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "--syntax=Lua54",
            "--respect-ignores",
            "--stdin-filepath",
            "{buffer_path}",
            "-",
          ],
        },
      },
    },
    "HTML": {
      "language_servers": ["vscode-html-language-server", "biome", "..."],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "biome",
        "!vscode-css-language-server",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "JavaScript": {
      "language_servers": ["vtsls", "biome", "!typescript-language-server", "..."],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "TypeScript": {
      "language_servers": ["vtsls", "biome", "!typescript-language-server", "..."],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "JSON": {
      "language_servers": ["json-language-server", "biome", "..."],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "JSONC": {
      "language_servers": ["json-language-server", "biome", "..."],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "Astro": {
      "language_servers": [
        "astro-language-server",
        "biome",
        "tailwindcss-language-server",
        "!typescript-language-server",
        "...",
      ],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "Svelte": {
      "language_servers": [
        "svelte-language-server",
        "biome",
        "tailwindcss-language-server",
        "!typescript-language-server",
        "...",
      ],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "YAML": {
      "language_servers": ["yaml-language-server", "..."],
      "formatter": {
        "external": {
          "command": "yamlfmt",
          "arguments": [
            "-in",
            "-formatter",
            "retain_line_breaks_single=true"
          ]
        }
      }
    },
    "SQL": {
      "tab_size": 4,
      // "language_servers": ["postgres-language-server"],
      "formatter": {
        "external": {
          "command": "pg_format",
          "arguments": ["-"]
        }
      }
    },
    "Go": {
      "tab_size": 4,
      "language_servers": ["gopls", "golangci-lint", "..."],
      "formatter": {
        "language_server": {
          "name": "gopls"
        },
      },
    },
    "Python": {
      "tab_size": 4,
      "language_servers": [
        "ty",
        "ruff",
        "!pylsp",
        "!pyright",
        "!basedpyright",
        "..."],
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true
      }
    },
    "C++": {
      "tab_size": 4,
    },
    "CMake": {
      "tab_size": 4,
    },
    "QML": {
      "tab_size": 2,
    },
  },


  // LSP
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    },
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
        "local": "standard"
      },
    },
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--issues-exit-code=1",
        ],
      },
    },
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "astro": "html",
          "svelte": "html",
        },
        "experimental": {
          "classRegex": [
            // Astro and Svelte
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            // Astro
            "class:list=\"{([^}]*)}\"",
            "class:list='{([^}]*)}'",
            // Svelte
            "class:\\s*([^\\s{]+)",
            "\\{\\s*class:\\s*\"([^\"]*)\"",
            "\\{\\s*class:\\s*'([^']*)'"
          ]
        }
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 80,
        },
      },
    },
  },


  // Auto Install
  "auto_install_extensions": {
    "basher": true,
    "lua": true,
    "html": true,
    "biome": true,
    "astro": true,
    "svelte": true,
    "unocss": true,
    "docker-compose": true,
    "dockerfile": true,
    "nginx": true,
    "sql": true,
    "golangci-lint": true,
    "make": true,
    "fish": true,
    "neocmake": true,
    "qml": true,
    "ini": true,
    "xml": true,
    "toml": true,
    "env": true,
    "csv": true,
    "rainbow-csv": true,
    "log": true,
    "git-firefly": true,
    "codebook": true,
  },


  // Terminal
  "terminal": {
    "shell": {
      "program": "zsh",
    },
    "toolbar": {
      "breadcrumbs": false,
    },
    "line_height": "standard",
  },
}
